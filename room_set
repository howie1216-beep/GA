<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PMS-上傳官網使用的房型</title>
    <style>
        :root {
            --primary-color: #f7b731;
            --bg-color: #fcfaf5;
            --text-color: #333333;
            --card-bg: #ffffff;
            --border-color: #eaeaea;
        }
        body {
            font-family: 'Helvetica Neue', Arial, 'LiHei Pro', '微軟正黑體', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            margin: 0;
            padding: 40px 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background-color: var(--card-bg);
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            padding: 40px;
            border: 1px solid var(--border-color);
        }
        h1 {
            text-align: center;
            color: #2c3e50;
            border-bottom: 4px solid var(--primary-color);
            display: inline-block;
            padding-bottom: 10px;
            margin-bottom: 30px;
        }
        .step-list {
            list-style: none;
            padding: 0;
        }
        .step-list li {
            background-color: #f9f9f9;
            margin-bottom: 15px;
            padding: 20px;
            border-radius: 6px;
            border-left: 4px solid #2c3e50;
            transition: all 0.3s ease;
        }
        .step-list li:hover {
            border-left-color: var(--primary-color);
            background-color: #fffaf0;
        }
        .step-list li strong {
            color: #2c3e50;
            font-size: 1.1em;
            display: block;
            margin-bottom: 5px;
        }
        .nav-buttons {
            display: flex;
            justify-content: space-between;
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #eaeaea;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            padding: 12px 24px;
            text-decoration: none;
            font-weight: bold;
            border-radius: 8px;
            transition: all 0.3s ease;
            color: #fff;
        }
        .btn-prev {
            background-color: #95a5a6;
        }
        .btn-prev:hover {
            background-color: #7f8c8d;
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .btn-next {
            background-color: #2c3e50;
        }
        .btn-next:hover {
            background-color: var(--primary-color);
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .btn span {
            margin: 0 8px;
        }
        
        /* 手機版響應式設計 */
        @media (max-width: 600px) {
            .nav-buttons {
                flex-direction: column;
                gap: 15px;
            }
            .btn {
                justify-content: center;
                width: 100%;
                box-sizing: border-box;
            }
        }
    </style>
</head>
<body>
